# Copy to .env in the directory where you start the CLI.
OPENAI_API_KEY=replace-with-your-api-key
# Set a Responses API model available to your account (required).
OPENAI_MODEL=replace-with-your-model
# Optional: omit for OpenAI, or set a Responses-compatible endpoint.
# OPENAI_BASE_URL=https://api.deepseek.com
AGENT_MAX_ROUNDS=10
AGENT_REQUEST_TIMEOUT_SECONDS=60
AGENT_TOOL_TIMEOUT_SECONDS=10
AGENT_LOG_LEVEL=INFO
AGENT_DATABASE_PATH=.heybuddy/heybuddy.sqlite3
