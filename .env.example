# Copy to .env in the directory where you start the CLI.
OPENAI_API_KEY=replace-with-your-api-key
# Set a Responses API model available to your account (required).
OPENAI_MODEL=replace-with-your-model
# Optional: omit for OpenAI, or set a Responses-compatible endpoint.
# OPENAI_BASE_URL=https://api.deepseek.com
# Required: set the actual token window supported by OPENAI_MODEL / your endpoint.
# No automatic model-window guess. Replace this placeholder before starting.
# deepseek-flash example (currently 1M): 1048576
AGENT_CONTEXT_WINDOW=replace-with-actual-model-window-tokens
AGENT_RESERVED_OUTPUT_TOKENS=4096
AGENT_CONTEXT_SAFETY_MARGIN=1024
AGENT_COMPACTION_TRIGGER_RATIO=0.8
AGENT_RECENT_RUNS=2
AGENT_HISTORY_PAGE_RUNS=32
AGENT_SUMMARY_TOKENS=2048
AGENT_SUMMARY_OUTPUT_TOKENS=4096
AGENT_COMPACTION_INPUT_TOKENS=16384
AGENT_COMPACTION_TIMEOUT_SECONDS=30
AGENT_MAX_COMPACTION_STEPS=16
# Manual /reflect only; input/output limits and timeout are independent of Compaction.
AGENT_REFLECTION_INPUT_TOKENS=16384
# API total includes reasoning; visible JSON has an independent UTF-8 byte limit.
AGENT_REFLECTION_OUTPUT_TOKENS=16384
AGENT_REFLECTION_RESPONSE_MAX_BYTES=32768
AGENT_REFLECTION_TIMEOUT_SECONDS=60
AGENT_REFLECTION_PAGE_RUNS=8
AGENT_MAX_ROUNDS=10
AGENT_REQUEST_TIMEOUT_SECONDS=60
AGENT_TOOL_TIMEOUT_SECONDS=10
AGENT_LOG_LEVEL=INFO
AGENT_DATABASE_PATH=.heybuddy/heybuddy.sqlite3
# New installs: user data directory. Existing <database_path>.memory is kept on upgrade.
# Optional root; actual files live under <root>/<agent_id>/. Keep outside source repos.
# AGENT_MEMORY_ROOT=D:/private-data/heybuddy-memory
AGENT_CORE_MEMORY_MAX_BYTES=8192

# Post-answer LLM memory check: off | suggest (default) | auto.
AGENT_MEMORY_AUTOMATION=suggest
AGENT_MEMORY_AUTOMATION_MAX_REQUESTS=4
AGENT_MEMORY_AUTOMATION_MAX_TOKENS=131072
AGENT_MEMORY_AUTOMATION_TIMEOUT_SECONDS=180
# Optional JSON object of exact knowledge topic path -> preapproved Markdown SHA256.
# Only small create operations can auto-apply; no grants means review even in auto mode.
# AGENT_MEMORY_AUTO_CREATE_GRANTS={}

# P1: bounded post-answer Episode organization; new input cancels pending requests.
AGENT_ORGANIZATION_ENABLED=true
AGENT_ORGANIZATION_IDLE_SECONDS=1500
AGENT_ORGANIZATION_RUN_THRESHOLD=8
AGENT_ORGANIZATION_PAGE_RUNS=8
AGENT_ORGANIZATION_INPUT_TOKENS=24576
AGENT_ORGANIZATION_OUTPUT_TOKENS=8192
AGENT_ORGANIZATION_TIMEOUT_SECONDS=60
AGENT_ORGANIZATION_WEAK_GAP_SECONDS=900
AGENT_ORGANIZATION_STRONG_GAP_SECONDS=5400
AGENT_ORGANIZATION_SPLIT_GAP_SECONDS=10800
AGENT_ORGANIZATION_REVISION_SECONDS=10800
AGENT_ORGANIZATION_THREAD_THRESHOLD=3
AGENT_ORGANIZATION_THREAD_INTERVAL_SECONDS=14400
AGENT_ORGANIZATION_CHECK_SECONDS=60
AGENT_ORGANIZATION_COOLDOWN_SECONDS=60
AGENT_ORGANIZATION_MAINTENANCE_BATCHES=4
AGENT_ORGANIZATION_MAINTENANCE_REQUESTS=4
AGENT_ORGANIZATION_MAINTENANCE_TOKENS=131072
AGENT_ORGANIZATION_MAINTENANCE_SECONDS=120
AGENT_ORGANIZATION_REPAIR_RETRY_SECONDS=300
AGENT_ORGANIZATION_REPAIR_MAX_FAILURES=3
AGENT_ORGANIZATION_SOURCE_BYTES=65536
AGENT_ORGANIZATION_RESPONSE_BYTES=32768
AGENT_RETRIEVAL_EPISODE_LIMIT=3
AGENT_RETRIEVAL_RAW_RUN_LIMIT=2
AGENT_RETRIEVAL_MAX_RUN_BYTES=65536
AGENT_RETRIEVAL_OPTIONAL_TOKENS=12288
AGENT_RETRIEVAL_SCAN_EPISODES=200
# P2 自动记忆默认启用；首次启用记录水位，不静默重学旧数据。
AGENT_MEMORY_LEARNING_ENABLED=true
AGENT_MEMORY_LEARNING_BATCH_EPISODES=3
AGENT_MEMORY_LEARNING_MAX_WAIT_SECONDS=21600
AGENT_MEMORY_PRIORITY_ENABLED=true
AGENT_MEMORY_LEARNING_INPUT_TOKENS=16384
AGENT_MEMORY_LEARNING_OUTPUT_TOKENS=16384
AGENT_MEMORY_LEARNING_TIMEOUT_SECONDS=60
AGENT_MEMORY_LEARNING_SOURCE_BYTES=131072
AGENT_MEMORY_LEARNING_MAX_FILES=2
AGENT_MEMORY_LEARNING_RECOVERY_ATTEMPTS=3
AGENT_MEMORY_LEARNING_RECOVERY_INTERVAL_SECONDS=300
AGENT_MEMORY_LEARNING_RECOVERY_SECONDS=2
AGENT_MEMORY_CURATOR_ENABLED=true
AGENT_MEMORY_CURATOR_INTERVAL_SECONDS=86400
AGENT_MEMORY_CURATOR_UPDATE_THRESHOLD=12
AGENT_MEMORY_CURATOR_LONG_FILE_BYTES=12000
AGENT_MEMORY_RETRIEVAL_ENABLED=true
AGENT_MEMORY_RETRIEVAL_LLM_PREFLIGHT=true
AGENT_MEMORY_RETRIEVAL_INPUT_TOKENS=8192
AGENT_MEMORY_RETRIEVAL_OUTPUT_TOKENS=2048
AGENT_MEMORY_RETRIEVAL_TIMEOUT_SECONDS=10
# P3 passive character mode is opt-in; legacy behavior remains the default.
AGENT_CHARACTER_ID=none
# To enable: AGENT_CHARACTER_ID=sherlock_bbc
# Optional trusted local package root; no downloads or package code execution.
# AGENT_CHARACTER_ROOT=path/to/local/characters
AGENT_CHARACTER_MAX_FILE_BYTES=16384
AGENT_CHARACTER_MAX_CONTEXT_BYTES=24576
AGENT_CHARACTER_CONTEXTUAL_BYTES=6144
AGENT_CHARACTER_EXAMPLE_COUNT=2
AGENT_CHARACTER_LORE_SECTIONS=2
AGENT_CHARACTER_VARIANT=E2
# Only active in enabled E2 character mode, passive idle maintenance; never sends messages.
AGENT_CHARACTER_STATE_ENABLED=true
AGENT_CHARACTER_STATE_MOOD_SECONDS=3600
AGENT_CHARACTER_STATE_FOCUS_SECONDS=10800
AGENT_CHARACTER_STATE_MIN_INTERVAL_SECONDS=900
AGENT_CHARACTER_STATE_INPUT_TOKENS=24576
AGENT_CHARACTER_STATE_OUTPUT_TOKENS=2048
AGENT_CHARACTER_STATE_TIMEOUT_SECONDS=20
AGENT_CHARACTER_STATE_SOURCE_BYTES=32768
